# ─────────────────────────────────────────────
# Together — variables de entorno
# Copiar a apps/api/.env y apps/web/.env según corresponda
# ─────────────────────────────────────────────

# --- API ---
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000

# --- Database (PostgreSQL local vía Docker) ---
# Cuando migremos a Supabase/Neon solo cambia DATABASE_URL
DATABASE_URL=postgresql://together:together@localhost:5432/together?schema=public

# --- Auth ---
# Genera secretos con: openssl rand -hex 48
JWT_ACCESS_SECRET=change_me_access_secret_min_48_chars_long_xxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_48_chars_long_xxxxxxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS ---
WEB_ORIGIN=http://localhost:5173

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000